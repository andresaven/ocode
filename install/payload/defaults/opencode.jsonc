{
  "$schema": "https://opencode.ai/config.json",

  // Referencia al AGENTS global.
  "instructions": ["~/.config/opencode/AGENTS.md"],

  // Las reglas se evalúan en orden; la última coincidencia prevalece.
  "permissions": [
    // Preguntas modales y skills.
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },

    // Acceso externo: bloqueado salvo las rutas autorizadas abajo.
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.jdks/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/etc/ocode/project-skills/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/etc/ocode/project-AGENTS.md", "effect": "allow" },

    // Lectura.
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "/tmp/**", "effect": "allow" },
    { "action": "read", "resource": "*src/main/resources/application-desa.yaml*", "effect": "deny" },
    { "action": "read", "resource": "*src/main/resources/application-pre.yaml*", "effect": "deny" },
    { "action": "read", "resource": "*src/main/resources/application-pro.yaml*", "effect": "deny" },
    { "action": "read", "resource": "*src/main/resources/db/production*", "effect": "deny" },
    { "action": "read", "resource": "*src/main/resources/db/db.changelog-desa.yaml*", "effect": "deny" },
    { "action": "read", "resource": "*src/main/resources/db/db.changelog-pre.yaml*", "effect": "deny" },
    { "action": "read", "resource": "*src/main/resources/db/liquibase-desa.properties*", "effect": "deny" },
    { "action": "read", "resource": "*src/main/resources/db/liquibase-pre.properties*", "effect": "deny" },
    { "action": "read", "resource": "*k8s*", "effect": "deny" },
    { "action": "read", "resource": "*src/main/resources/configuration/des*", "effect": "deny" },
    { "action": "read", "resource": "*src/main/resources/configuration/pre*", "effect": "deny" },
    { "action": "read", "resource": "*src/main/resources/configuration/prod*", "effect": "deny" },
    { "action": "read", "resource": "*src/main/resources/certs*", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "**/.env", "effect": "deny" },
    { "action": "read", "resource": "**/.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "**/.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.keytab", "effect": "deny" },
    { "action": "read", "resource": "*.pfx", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.jks", "effect": "deny" },
    { "action": "read", "resource": "*.keystore", "effect": "deny" },
    { "action": "read", "resource": "*.ppk", "effect": "deny" },
    { "action": "read", "resource": "*.kdbx", "effect": "deny" },
    { "action": "read", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "read", "resource": "*.npmrc", "effect": "deny" },
    { "action": "read", "resource": "**/.npmrc", "effect": "deny" },
    { "action": "read", "resource": "*.netrc", "effect": "deny" },
    { "action": "read", "resource": "**/.netrc", "effect": "deny" },
    { "action": "read", "resource": "*settings.xml", "effect": "deny" },
    { "action": "read", "resource": "*/credentials", "effect": "deny" },
    { "action": "read", "resource": "*/credentials.*", "effect": "deny" },
    { "action": "read", "resource": "*.properties", "effect": "deny" },
    { "action": "read", "resource": "*application*.yml", "effect": "deny" },
    { "action": "read", "resource": "*application*.yaml", "effect": "deny" },
    { "action": "read", "resource": "*bootstrap*.yml", "effect": "deny" },
    { "action": "read", "resource": "*bootstrap*.yaml", "effect": "deny" },
    { "action": "read", "resource": "/etc/ocode/project-skills/*", "effect": "allow" },
    { "action": "read", "resource": "/etc/ocode/project-AGENTS.md", "effect": "allow" },

    // Edición.
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "/tmp/**", "effect": "allow" },
    { "action": "edit", "resource": "*src/main/resources/application-desa.yaml*", "effect": "deny" },
    { "action": "edit", "resource": "*src/main/resources/application-pre.yaml*", "effect": "deny" },
    { "action": "edit", "resource": "*src/main/resources/application-pro.yaml*", "effect": "deny" },
    { "action": "edit", "resource": "*src/main/resources/db/production*", "effect": "deny" },
    { "action": "edit", "resource": "*src/main/resources/db/db.changelog-desa.yaml*", "effect": "deny" },
    { "action": "edit", "resource": "*src/main/resources/db/db.changelog-pre.yaml*", "effect": "deny" },
    { "action": "edit", "resource": "*src/main/resources/db/liquibase-desa.properties*", "effect": "deny" },
    { "action": "edit", "resource": "*src/main/resources/db/liquibase-pre.properties*", "effect": "deny" },
    { "action": "edit", "resource": "*k8s*", "effect": "deny" },
    { "action": "edit", "resource": "*src/main/resources/configuration/des*", "effect": "deny" },
    { "action": "edit", "resource": "*src/main/resources/configuration/pre*", "effect": "deny" },
    { "action": "edit", "resource": "*src/main/resources/configuration/prod*", "effect": "deny" },
    { "action": "edit", "resource": "*src/main/resources/certs*", "effect": "deny" },
    { "action": "edit", "resource": "**/.git/**", "effect": "deny" },
    { "action": "edit", "resource": "**/.svn/**", "effect": "deny" },
    { "action": "edit", "resource": "**/target/**", "effect": "deny" },
    { "action": "edit", "resource": "**/node_modules/**", "effect": "deny" },
    { "action": "edit", "resource": "**/dist/**", "effect": "deny" },
    { "action": "edit", "resource": "**/build/**", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "**/.env", "effect": "deny" },
    { "action": "edit", "resource": "**/.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*.pfx", "effect": "deny" },
    { "action": "edit", "resource": "*.p12", "effect": "deny" },
    { "action": "edit", "resource": "*.jks", "effect": "deny" },
    { "action": "edit", "resource": "*.keystore", "effect": "deny" },
    { "action": "edit", "resource": "*.ppk", "effect": "deny" },
    { "action": "edit", "resource": "*.kdbx", "effect": "deny" },
    { "action": "edit", "resource": "*settings.xml", "effect": "deny" },
    { "action": "edit", "resource": "*.npmrc", "effect": "deny" },
    { "action": "edit", "resource": "**/.npmrc", "effect": "deny" },
    { "action": "edit", "resource": "/etc/ocode/project-skills/*", "effect": "allow" },
    { "action": "edit", "resource": "/etc/ocode/project-AGENTS.md", "effect": "allow" },

    // Listado de archivos (V2: glob).
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*src/main/resources/configuration/des*", "effect": "deny" },
    { "action": "glob", "resource": "*src/main/resources/configuration/pre*", "effect": "deny" },
    { "action": "glob", "resource": "*src/main/resources/configuration/prod*", "effect": "deny" },
    { "action": "glob", "resource": "*src/main/resources/certs*", "effect": "deny" },
    { "action": "glob", "resource": "*src/main/resources/application-desa.yaml*", "effect": "deny" },
    { "action": "glob", "resource": "*src/main/resources/application-pre.yaml*", "effect": "deny" },
    { "action": "glob", "resource": "*src/main/resources/application-pro.yaml*", "effect": "deny" },
    { "action": "glob", "resource": "*src/main/resources/db/production*", "effect": "deny" },
    { "action": "glob", "resource": "*src/main/resources/db/db.changelog-desa.yaml*", "effect": "deny" },
    { "action": "glob", "resource": "*src/main/resources/db/db.changelog-pre.yaml*", "effect": "deny" },
    { "action": "glob", "resource": "*src/main/resources/db/liquibase-desa.properties*", "effect": "deny" },
    { "action": "glob", "resource": "*src/main/resources/db/liquibase-pre.properties*", "effect": "deny" },
    { "action": "glob", "resource": "*k8s*", "effect": "deny" },

    // Shell.
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "mvn *", "effect": "allow" },
    { "action": "shell", "resource": "npm run build*", "effect": "allow" },
    { "action": "shell", "resource": "npm test*", "effect": "allow" },
    { "action": "shell", "resource": "java -version", "effect": "allow" },

    // Denegaciones de Maven, después de la regla general allow.
    { "action": "shell", "resource": "mvn *liquibase*", "effect": "deny" },
    { "action": "shell", "resource": "mvn *spring-boot:run*", "effect": "deny" },
    { "action": "shell", "resource": "mvn *-Pdesa*", "effect": "deny" },
    { "action": "shell", "resource": "mvn *-Ppre*", "effect": "deny" },
    { "action": "shell", "resource": "mvn *-Ppro*", "effect": "deny" },
    { "action": "shell", "resource": "mvn *-P *", "effect": "deny" },
    { "action": "shell", "resource": "mvn *-P*,*", "effect": "deny" },
    { "action": "shell", "resource": "mvn *--activate-profiles*", "effect": "deny" },
    { "action": "shell", "resource": "mvn *spring.profiles.active*", "effect": "deny" },
    { "action": "shell", "resource": "mvn *envTarget*", "effect": "deny" },
    { "action": "shell", "resource": "mvn -X*", "effect": "deny" },
    { "action": "shell", "resource": "mvn * -X*", "effect": "deny" },
    { "action": "shell", "resource": "mvn *--debug*", "effect": "deny" },
    { "action": "shell", "resource": "mvn *help:effective*", "effect": "deny" },
    { "action": "shell", "resource": "mvn *deploy*", "effect": "deny" },
    { "action": "shell", "resource": "mvn *versions:set*", "effect": "deny" },
    { "action": "shell", "resource": "mvn *exec:*", "effect": "deny" },
    { "action": "shell", "resource": "mvn *--settings*", "effect": "deny" },
    { "action": "shell", "resource": "mvn * -s *", "effect": "deny" },

    // Base de datos.
    { "action": "shell", "resource": "sqlplus*", "effect": "deny" },
    { "action": "shell", "resource": "sqlcl*", "effect": "deny" },
    { "action": "shell", "resource": "sql *", "effect": "deny" },
    { "action": "shell", "resource": "psql*", "effect": "deny" },
    { "action": "shell", "resource": "mysql*", "effect": "deny" },

    // Exploración/lectura mediante shell.
    { "action": "shell", "resource": "*-Recurse*", "effect": "deny" },
    { "action": "shell", "resource": "Get-ChildItem*", "effect": "deny" },
    { "action": "shell", "resource": "gci *", "effect": "deny" },
    { "action": "shell", "resource": "dir *", "effect": "deny" },
    { "action": "shell", "resource": "find *", "effect": "deny" },
    { "action": "shell", "resource": "tree*", "effect": "deny" },
    { "action": "shell", "resource": "where *", "effect": "deny" },
    { "action": "shell", "resource": "Select-String*", "effect": "deny" },
    { "action": "shell", "resource": "findstr*", "effect": "deny" },
    { "action": "shell", "resource": "type *", "effect": "deny" },
    { "action": "shell", "resource": "cat *", "effect": "deny" },
    { "action": "shell", "resource": "Get-Content*", "effect": "deny" },

    // Descarga/ejecución remota y ofuscación.
    { "action": "shell", "resource": "Invoke-WebRequest*", "effect": "deny" },
    { "action": "shell", "resource": "iwr *", "effect": "deny" },
    { "action": "shell", "resource": "curl*", "effect": "deny" },
    { "action": "shell", "resource": "wget*", "effect": "deny" },
    { "action": "shell", "resource": "Invoke-Expression*", "effect": "deny" },
    { "action": "shell", "resource": "iex *", "effect": "deny" },
    { "action": "shell", "resource": "*-EncodedCommand*", "effect": "deny" },
    { "action": "shell", "resource": "*-enc *", "effect": "deny" },
    { "action": "shell", "resource": "Start-Process*", "effect": "deny" },
    { "action": "shell", "resource": "Set-ExecutionPolicy*", "effect": "deny" },

    // Acceso web.
    { "action": "webfetch", "resource": "*", "effect": "ask" },

    // Habilita los archivos de skills e instrucciones externas indicados arriba.
    { "action": "skill", "resource": "*", "effect": "allow" }
  ],

  "watcher": {
    "ignore": ["**/target/**", "**/node_modules/**", "**/dist/**", "**/build/**"]
  },

  "skills": ["/etc/ocode/project-skills"]
}
