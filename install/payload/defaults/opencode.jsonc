{
  "$schema": "https://opencode.ai/config.json",
  // Estandar de seguridad opencode v1.0.1
  // Se referencia el AGENTS.md global para garantizar su carga: hay un bug reportado por el que
  // se ignora cuando el proyecto tiene su propio AGENTS.md. Si tu version ya lo carga siempre
  // (y notas contenido duplicado), puedes quitar esta linea.
  // Si {env:USERPROFILE} no se expande en tu version, usar la ruta absoluta.
  "instructions": ["~/.config/opencode/AGENTS.md"],
  // IMPORTANTE: en opencode gana la ULTIMA regla que coincide.
  // Por eso el comodin "*" va siempre primero y las reglas especificas despues.
  "permission": {
    "read": {
      "*": "allow",
      "*src/main/resources/application-desa.yaml*": "deny",
      "*src/main/resources/application-pre.yaml*": "deny",
      "*src/main/resources/application-pro.yaml*": "deny",
      "*src/main/resources/db/production*": "deny",
      "*src/main/resources/db/db.changelog-desa.yaml*": "deny",
      "*src/main/resources/db/db.changelog-pre.yaml*": "deny",
      "*src/main/resources/db/liquibase-desa.properties*": "deny",
      "*src/main/resources/db/liquibase-pre.properties*": "deny",
      "*k8s*": "deny",
	  "*src/main/resources/configuration/des*": "deny",
      "*src/main/resources/configuration/pre*": "deny",
      "*src/main/resources/configuration/prod*": "deny",
      "*src/main/resources/certs*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.env.example": "allow",
      "**/.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.keytab": "deny",
      "*.pfx": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*.keystore": "deny",
      "*.ppk": "deny",
      "*.kdbx": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*.npmrc": "deny",
      "**/.npmrc": "deny",
      "*.netrc": "deny",
      "**/.netrc": "deny",
      "*settings.xml": "deny",
      "*/credentials": "deny",
      "*/credentials.*": "deny",
      "*.properties": "deny",
      "*application*.yml": "deny",
      "*application*.yaml": "deny",
      "*bootstrap*.yml": "deny",
      "*bootstrap*.yaml": "deny"
    },
    "edit": {
      "*": "allow",
      "*src/main/resources/application-desa.yaml*": "deny",
      "*src/main/resources/application-pre.yaml*": "deny",
      "*src/main/resources/application-pro.yaml*": "deny",
      "*src/main/resources/db/production*": "deny",
      "*src/main/resources/db/db.changelog-desa.yaml*": "deny",
      "*src/main/resources/db/db.changelog-pre.yaml*": "deny",
      "*src/main/resources/db/liquibase-desa.properties*": "deny",
      "*src/main/resources/db/liquibase-pre.properties*": "deny",
      "*k8s*": "deny",
	  "*src/main/resources/configuration/des*": "deny",
      "*src/main/resources/configuration/pre*": "deny",
      "*src/main/resources/configuration/prod*": "deny",
      "*src/main/resources/certs*": "deny",
      "**/.git/**": "deny",
      "**/.svn/**": "deny",
      "**/target/**": "deny",
      "**/node_modules/**": "deny",
      "**/dist/**": "deny",
      "**/build/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.pfx": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*.keystore": "deny",
      "*.ppk": "deny",
      "*.kdbx": "deny",
      "*settings.xml": "deny",
      "*.npmrc": "deny",
      "**/.npmrc": "deny"
    },
    "list": {
      "*": "allow",
      "*src/main/resources/configuration/des*": "deny",
      "*src/main/resources/configuration/pre*": "deny",
      "*src/main/resources/configuration/prod*": "deny",
      "*src/main/resources/certs*": "deny",
      "*src/main/resources/application-desa.yaml*": "deny",
      "*src/main/resources/application-pre.yaml*": "deny",
      "*src/main/resources/application-pro.yaml*": "deny",
      "*src/main/resources/db/production*": "deny",
      "*src/main/resources/db/db.changelog-desa.yaml*": "deny",
      "*src/main/resources/db/db.changelog-pre.yaml*": "deny",
      "*src/main/resources/db/liquibase-desa.properties*": "deny",
      "*src/main/resources/db/liquibase-pre.properties*": "deny",
      "*k8s*": "deny"
    },
    "bash": {
      "*": "ask",

      // Permitidos: build y pruebas sin friccion
      "mvn *": "allow",
      "npm run build*": "allow",
      "npm test*": "allow",
      "java -version": "allow",
      // svn de solo lectura: se permite en el opencode.json de cada proyecto que lo use

      // Prohibidos: base de datos, despliegue y ejecucion arbitraria via Maven.
      // (Se declaran DESPUES de "mvn *" para que ganen.)
      "mvn *liquibase*": "deny",
      "mvn *spring-boot:run*": "deny",
      "mvn *-Pdesa*": "deny",
      "mvn *-Ppre*": "deny",
      "mvn *-Ppro*": "deny",
      "mvn *-P *": "deny",
      // Bloquea perfiles combinados (-Plocal,desa). Efecto secundario: tambien
      // bloquea una coma posterior a -P (p. ej. -Dtest=A,B). Quitar si molesta.
      "mvn *-P*,*": "deny",
      "mvn *--activate-profiles*": "deny",
      "mvn *spring.profiles.active*": "deny",
      "mvn *envTarget*": "deny",
      "mvn -X*": "deny",
      "mvn * -X*": "deny",
      "mvn *--debug*": "deny",
      "mvn *help:effective*": "deny",
      "mvn *deploy*": "deny",
      "mvn *versions:set*": "deny",
      "mvn *exec:*": "deny",
      "mvn *--settings*": "deny",
      "mvn * -s *": "deny",
      "sqlplus*": "deny",
      "sqlcl*": "deny",
      "sql *": "deny",
      "psql*": "deny",
      "mysql*": "deny",

      // Prohibidos: explorar / leer con el shell
      "*-Recurse*": "deny",
      "Get-ChildItem*": "deny",
      "gci *": "deny",
      "dir *": "deny",
      "find *": "deny",
      "tree*": "deny",
      "where *": "deny",
      "Select-String*": "deny",
      "findstr*": "deny",
      "type *": "deny",
      "cat *": "deny",
      "Get-Content*": "deny",

      // Prohibidos: descarga / ejecucion remota y ofuscacion
      "Invoke-WebRequest*": "deny",
      "iwr *": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "Invoke-Expression*": "deny",
      "iex *": "deny",
      "*-EncodedCommand*": "deny",
      "*-enc *": "deny",
      "Start-Process*": "deny",
      "Set-ExecutionPolicy*": "deny"
    },
    // Salida de datos y acceso fuera del repo
    "webfetch": "ask",
    "external_directory": {
      "*": "deny",
      "~/.jdks/**": "allow"
    }
  },

  // Evita eventos innecesarios si se activa el file watcher experimental.
  "watcher": {
    "ignore": ["**/target/**", "**/node_modules/**", "**/dist/**", "**/build/**"]
  }
}
